
  <% @articles.each do |a| %>
    <div class="card mb-3 shadow-sm">
  <div class="card-body">
    <h5 class="card-title"><%= link_to a.title, article_path(a), class: "text-decoration-none" %></h5>
    <p class="card-text text-muted"><%= truncate(a.content, length: 200) %></p>
  </div>
</div>
  <% end %>
